# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
TIME_ZONE=Europe/Madrid

# Postgres
POSTGRES_DB=mercadona
POSTGRES_USER=mercadona
POSTGRES_PASSWORD=mercadona
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Gmail
GMAIL_CREDENTIALS_FILE=/app/secrets/credentials.json
GMAIL_TOKEN_FILE=/app/secrets/token.json
# Only Mercadona's sender. If the mailbox is dedicated to receipts and you forward
# them by hand or "as attachment" (.eml), use: GMAIL_QUERY=has:attachment
GMAIL_QUERY=from:ticket_digital@mail.mercadona.com has:attachment filename:pdf
GMAIL_SYNC_HOUR=7
GMAIL_SYNC_MINUTE=0

# Mercadona online shop: postal code and the warehouse that serves it (see docs/installation.md)
MERCADONA_POSTAL_CODE=41008
MERCADONA_WAREHOUSE=svq1

# Weekly email summary (FR-15). Empty recipient = not sent.
# Needs a Gmail token with send permission: run `make gmail-auth` again.
REPORT_EMAIL_TO=
REPORT_DAY=mon
REPORT_HOUR=9
REPORT_MINUTE=0
REPORT_LANGUAGE=es
REPORT_BASE_URL=http://localhost:5173

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Host ports
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5433
