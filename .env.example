# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
TIME_ZONE=Europe/Madrid

# Postgres
POSTGRES_DB=mercadona
POSTGRES_USER=mercadona
POSTGRES_PASSWORD=mercadona
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Gmail
GMAIL_CREDENTIALS_FILE=/app/secrets/credentials.json
GMAIL_TOKEN_FILE=/app/secrets/token.json
GMAIL_QUERY=from:mercadona has:attachment filename:pdf

# Mercadona API
MERCADONA_POSTAL_CODE=41008
MERCADONA_WAREHOUSE=svq1

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Host ports
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5433
