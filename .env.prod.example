# Production .env for the home server. Copy to .env and fill in the blanks.

# Django — generate a key with: openssl rand -base64 48
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,<server-ip>,<server-hostname>
CSRF_TRUSTED_ORIGINS=http://<server-ip>:8080,http://<server-hostname>:8080
TIME_ZONE=Europe/Madrid

# Postgres (only reachable inside the compose network) — use a strong password
POSTGRES_DB=mercadona
POSTGRES_USER=mercadona
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Gmail — copy secrets/credentials.json and secrets/token.json from the old machine
GMAIL_CREDENTIALS_FILE=/app/secrets/credentials.json
GMAIL_TOKEN_FILE=/app/secrets/token.json
GMAIL_QUERY=from:ticket_digital@mail.mercadona.com has:attachment filename:pdf
GMAIL_SYNC_HOUR=7
GMAIL_SYNC_MINUTE=0

MERCADONA_POSTAL_CODE=41008
MERCADONA_WAREHOUSE=svq1

# Built-in daily backups into ./backups (database + receipt PDFs).
# Enable with COMPOSE_PROFILES=backup unless the server has its own backup system.
#COMPOSE_PROFILES=backup
BACKUP_HOUR=3
BACKUP_MINUTE=30
BACKUP_KEEP_DAYS=14

# Port the web UI listens on
WEB_PORT=8080
